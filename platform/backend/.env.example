# ============================================
# SHAHEEN - YS Backend Configuration
# Copy to .env and fill in your values
# ============================================

# ===== Server =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ===== Database =====
DATABASE_PATH=./data/shaheen.db

# ===== JWT Authentication =====
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_EXPIRY=7d

# ===== Session =====
SESSION_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ===== Email (SMTP) =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="SHAHEEN-YS <noreply@shaheen-ys.local>"

# ===== Payment (Stripe) =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ===== Cloud Provider =====
CLOUD_PROVIDER_API_KEY=
CLOUD_PROVIDER_REGION=

# ===== Admin =====
ADMIN_EMAILS=admin@shaheen-ys.local
